<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Pane</string>
	<key>CFBundleIdentifier</key>
	<string>dev.colemei.pane</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Pane</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<!-- Pane lives in the menu bar. The Dock icon is opt-in (Settings > General), and turning it on
	     switches the activation policy at runtime rather than changing this key. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Updates (Sparkle). The feed is the newest published release's appcast; every update in it
	     must carry an EdDSA signature by the key whose public half is below, or it is refused.
	     Sparkle never checks on its own: the news is Pane's daily summon check (decision 136), and
	     Sparkle runs only when somebody presses Update. -->
	<key>SUFeedURL</key>
	<string>https://github.com/ColeMei/pane/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>39ASiUOApjBCrM/IlOTsvoZbE9QJpNXJfSlbRMSJ3SI=</string>
	<key>SUEnableAutomaticChecks</key>
	<false/>

	<!-- Deliberately absent: every NS*UsageDescription key. Global hotkeys go through
	     RegisterEventHotKey, which needs no Accessibility permission, and no network code ships.
	     Pane requests no privacy permissions at all — see decision 9. Adding a usage-description
	     key here means a promise was broken somewhere else. -->
</dict>
</plist>
